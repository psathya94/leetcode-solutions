//bfssolution = eg - [[1,1],2,[1,1]]
    //Time: O(N)
    //Space: O(N) worst case
    public int depthSum(List<NestedInteger> nestedList) {
        Queue<NestedInteger> q = new LinkedList<>();
        for(NestedInteger element : nestedList){
            q.offer(element); //[1,1],2,[1,1] - 3 elements
        }
        int depth =1;
        int result =0;
        while(!q.isEmpty()){
            int size = q.size();
            for(int i=0;i<size;i++){
                NestedInteger el = q.poll(); //[1,1]
                if(el.isInteger()){
                    result +=el.getInteger() *depth;
                }else{
                    for(NestedInteger e : el.getList()){
                        q.offer(e); //[1,1],2,[1,1] - 3 elements
                    }
                }
            }
            depth++;
        }
        return result;
    }

