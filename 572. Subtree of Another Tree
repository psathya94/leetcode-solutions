/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
 // TC - O(n * m)
 //isSameTree is O(m), but because we may invoke it at up to O(n) nodes in the main tree, the overall worst-case time complexity is O(n × m).
// SC - O(h1 + h2), worst case O(n + m)
class Solution {
    public boolean isSubtree(TreeNode root, TreeNode subRoot) {
        return searchRoot(root, subRoot);
    }

    private boolean searchRoot(TreeNode root, TreeNode subRoot) {
        if (root == null || subRoot == null)
            return false;

        if (root.val == subRoot.val) {
            if (isSameTree(root, subRoot))
                return true;
        }
        return searchRoot(root.left, subRoot) || searchRoot(root.right, subRoot);
    }

    private boolean isSameTree(TreeNode p, TreeNode q) {
        if (p == null || q == null)
            return p == q;
        if (p.val != q.val)
            return false;
        return isSameTree(p.left, q.left) && isSameTree(p.right, q.right);
    }
}
