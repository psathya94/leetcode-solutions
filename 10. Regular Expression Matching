//TC - O(m*n)
//SC - O(m*n)
class Solution {
    public boolean isMatch(String s, String p) {
        if (s.equals(p))
            return true;
        int c = p.length();
        int r = s.length();
        if (c == 0)
            return false;

        boolean[][] dp = new boolean[r + 1][c + 1];
        //fill first row
        dp[0][0] = true;
        for (int j = 1; j <= c; j++) {
            if (p.charAt(j - 1) == '*')
                dp[0][j] = dp[0][j - 2];
            //not needed as . should be false and by default dp array initial value is false
            /**else if (p.charAt(j - 1) == '.')
                dp[0][j] = dp[0][j - 1];
            else
                dp[0][j] = false;**/
        }

        for (int i = 1; i <= r; i++) {
            for (int j = 1; j <= c; j++) {
                // Normal character or '.'
                if (s.charAt(i - 1) == p.charAt(j - 1) || p.charAt(j - 1) == '.') {
                    dp[i][j] = dp[i - 1][j - 1];
                } else if (p.charAt(j - 1) == '*') {
                    //0 case - 2 steps back
                    dp[i][j] = dp[i][j - 2];
                    //1 case exists only if character before * matches the character in string
                    if (s.charAt(i - 1) == p.charAt(j - 2) || p.charAt(j - 2) == '.') {
                        dp[i][j] = dp[i][j] || dp[i - 1][j]; //0 case || 1 step up (1 case)
                    }
                }
            }
        }
        return dp[r][c];
    }
}

