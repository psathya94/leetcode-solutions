//TC - O(m*n)
//SC - O(1)
class Solution {
    public List<Integer> spiralOrder(int[][] matrix) {
        int row = matrix.length;
        int col = matrix[0].length;
        List<Integer> result = new ArrayList<>();

        int left = 0;
        int right = col - 1;
        int top = 0;
        int bottom = row - 1;

        while (left <= right && top <= bottom) {
            //first row
            for (int i = left; i <= right; i++) { // i--> 0,1,2
                result.add(matrix[top][i]);
            }
            top++;
            if (top <= bottom) {
                //last col
                for (int i = top; i <= bottom; i++) { // i--> 1,2
                    result.add(matrix[i][right]);
                }
                right--;
            }
            if (top <= bottom && left <= right) { //check both the conditions as top,bottom,left,right are mutated after the while loop
                //last row
                for (int i = right; i >= left; i--) { // i--> 1,2
                    result.add(matrix[bottom][i]);
                }
                bottom--;
            }
            if (top <= bottom && left <= right) { //check both the conditions as top,bottom,left,right are mutated after the while loop
                //first col
                for (int i = bottom; i >= top; i--) { // i--> 1, left=0 , 10
                    result.add(matrix[i][left]);
                }
                left++;
            }

        }
        return result;
    }
}
