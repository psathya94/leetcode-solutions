//Time:  O(n)
//Space: O(1)
//Next permutation = find pivot → swap with rightmost larger element → reverse suffix.
class Solution {
    public void nextPermutation(int[] nums) {
        int n = nums.length;
        int breach_position = -1;

        for (int i = n - 2; i >= 0; i--) {
            if (nums[i] < nums[i + 1]) {
                breach_position = i;
                break; //note
            }
        }
        // find the rightmost element greater than pivot
        if (breach_position != -1) { //note
            for (int j = n - 1; j >= 0; j--) {
                if (nums[j] > nums[breach_position]) {
                    //swap(j,breach_position)
                    System.out.println(nums[j] + " " + nums[breach_position]);
                    int temp = nums[j];
                    nums[j] = nums[breach_position];
                    nums[breach_position] = temp;
                    break;  //note
                }
            }
        }
        System.out.println(Arrays.toString(nums));
        reverse(nums, breach_position + 1, n - 1);

    }

    private void reverse(int[] nums, int start, int end) {
        while (start <= end) {
            int temp = nums[start];
            nums[start] = nums[end];
            nums[end] = temp;
            start++;
            end--;
        }
    }
}
