//TC - O(n)
//SC - O(n)
class Solution {
    public int rob(int[] nums) {
        int n = nums.length;
        int[] dp = new int[n];

        for(int i=0;i<n;i++){
            if(i==0){
                dp[0] = nums[0];
            }else if(i==1){
                dp[1] = Math.max(dp[0],nums[1]);
            }else{
                dp[i] = Math.max(dp[i-1], dp[i-2]+nums[i]);
            }
        }
        return dp[n-1];
    }
}
