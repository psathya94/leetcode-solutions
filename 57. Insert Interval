//Time:  O(n)
//Space: O(n)
class Solution {
    public int[][] insert(int[][] intervals, int[] newInterval) {
        List<int[]> result = new ArrayList<>();
        int newStart = newInterval[0];
        int newEnd = newInterval[1];
        for (int i = 0; i < intervals.length; i++) {
            int exStart = intervals[i][0];
            int exEnd = intervals[i][1];
            //3 conditions 
            //BEFORE
            if (exEnd < newStart) {
                result.add(new int[] { exStart, exEnd });
            }
            //AFTER
            else if (newEnd < exStart) {
                //copy new interval
                result.add(new int[] { newStart, newEnd });
                //copy remaining exiting intervals after copying new interval
                for (int j = i; j < intervals.length; j++) {
                    result.add(intervals[j]); //add remaining intervals starting j
                }
                return result.toArray(new int[result.size()][]);
            } else {
                //merge
                 newStart = Math.min(newStart, exStart);
                 newEnd = Math.max(newEnd, exEnd);
            }
        }
        //edge case to copy new interval when above 3 conditions fail
        result.add(new int[] { newStart, newEnd });

        return result.toArray(new int[result.size()][]);
    }
}
