//TC - O(N^2)
//SC - O(N) where N is the no.of rows
class Solution {
    public int minimumTotal(List<List<Integer>> triangle) {
        int n = triangle.size();
        int[] dp = new int[n];
        for (int j = 0; j < n; j++) { //fill last row into dp array
            dp[j] = triangle.get(n - 1).get(j);
        }
        for (int i = n - 2; i >= 0; i--) {
            //List<Integer> curr = triangle.get(i);
            for (int j = 0; j < triangle.get(i).size(); j++) {  //here j< triangle.get(i).size() is same as j < i
                dp[j] = triangle.get(i).get(j) + Math.min(dp[j], dp[j + 1]);
            }
        }
        return dp[0];
    }
}
