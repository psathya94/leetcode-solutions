class Solution {
    public int maxProduct(int[] nums) {
        int minProduct = nums[0];
        int maxProduct = nums[0];
        int ans = nums[0];
        for (int i = 1; i < nums.length; i++) {
            //3 options - nums[i],extendMinProduct, extend max product
            int minP = Math.min(nums[i], Math.min(nums[i] * maxProduct, nums[i] * minProduct));
            //3 options - nums[i],extendMinProduct, extend max product
            int maxP = Math.max(nums[i], Math.max(nums[i] * maxProduct, nums[i] * minProduct));
            
            minProduct = minP;
            maxProduct = maxP;
            ans = Math.max(ans, maxProduct);
        }
        return ans;
    }
}
