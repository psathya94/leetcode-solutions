DP solution
TC = O(coins × amount)
SC = O(coins × amount)
class Solution {
    public int coinChange(int[] coins, int amount) {
        int c = amount + 1;
        int r = coins.length + 1;
        int[][] dp = new int[r][c];
        System.out.println(Arrays.toString(dp));
        for (int j = 1; j < c; j++) { //first row where i=0
            dp[0][j] = 99999; // instead of Integer.MAX_VALUE use any max positive value as Integer.MAX_VALUE+1 result in overflow
        }
        //first row is filled, now start filling from 1
        for (int i = 1; i < r; i++) {
            for (int j = 1; j < c; j++) {
                if (j < coins[i - 1]) { //use coins[i-1] not coins[i], because j refers to dp array(additional row and col) and coins refers to given input
                    dp[i][j] = dp[i - 1][j];
                } else {
                    dp[i][j] = Math.min(dp[i - 1][j], 1 + dp[i][j - coins[i - 1]]);
                }
            }
        }
        return dp[r - 1][c - 1] == 99999 ? -1 : dp[r - 1][c - 1];
    }
}
