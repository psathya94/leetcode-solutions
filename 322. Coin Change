//Optimal solution
TC = O(coins × amount)
SC = O(amount)
class Solution {
    public int coinChange(int[] coins, int amount) {
        int c = amount + 1;
        int r = coins.length + 1;
        int[] dp = new int[c];
        for (int j = 1; j < c; j++) { 
            dp[j] = 99999; // instead of Integer.MAX_VALUE use any max positive value as Integer.MAX_VALUE+1 result in overflow
        }
        //first row is filled, now start filling from 1
        for (int i = 1; i < r; i++) {
            for (int j = 1; j < c; j++) {
                if (j >= coins[i - 1]) 
                    dp[j] = Math.min(dp[j], 1 + dp[j - coins[i - 1]]);
            }
        }
        return dp[c - 1] == 99999 ? -1 : dp[c - 1];
    }
}
