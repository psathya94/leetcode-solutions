It is easy to identify repetetive subproblem in 01 recursion
// TC - O(2^m+n)
// SC - O(h) // recursion stack
class Solution {
    int result = Integer.MAX_VALUE;

    public int coinChange(int[] coins, int amount) {
        dfs(0, coins, amount, 0);
        return result == Integer.MAX_VALUE ? -1 : result;
    }

    private int dfs(int i, int[] coins, int amount, int no_of_coins) {
        //base
        if (amount < 0 || i==coins.length)
            return Integer.MAX_VALUE;
        if (amount == 0) {
            result = Math.min(result, no_of_coins);
            return no_of_coins;
        }
        int choose = dfs(i, coins, amount - coins[i], no_of_coins + 1);
        int dontchoose = dfs(i+1, coins, amount, no_of_coins);
        return Math.min(choose, dontchoose);
    }
}
