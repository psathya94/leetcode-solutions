//TC - O(n^2) n*n matrix
//SC - O(1)
class Solution {
    public void rotate(int[][] matrix) {
        //transpose
        int m = matrix.length;
        
        for (int i = 0; i < m; i++) {
            for (int j = i; j < m; j++) {
                if(i==j)
                    continue;
                int temp = matrix[i][j];
                matrix[i][j] = matrix[j][i];
                matrix[j][i] = temp;
            }
        }
        //reverse each row
        for (int i = 0; i < m; i++) {
            int start = 0;
            int end = m-1;
            while(start<end){
                int temp = matrix[i][start];
                matrix[i][start] = matrix[i][end];
                matrix[i][end] = temp;
                start++;
                end--;
            }
        }
    }
}
