//TC-O(n log n)
//SC - O(1) excluding sorting space
class Solution {
    public int arrayPairSum(int[] nums) {
        int n = nums.length;
        Arrays.sort(nums);
        int result = 0;
        for (int i = 0; i < n; i = i + 2) {
            //result += Math.min(nums[i], nums[i + 1]); or
            result += nums[i];
        }
        return result;
    }
}
