//TC - O(L)
//SC - O(1)
class Solution {
    public boolean isRobotBounded(String instructions) {
        int[][] directions = {{0,1},{-1,0},{0,-1},{1,0}}; //N,W,S,E (anti-clockwise)
        int idx =0;
        int x=0;
        int y=0;
        for(char c: instructions.toCharArray()){
            if(c=='G'){
                x = x+ directions[idx][0];
                y = y+ directions[idx][1];
            }else if(c=='L'){
                idx = (idx+1)%4;
            }else{
                idx = (idx+3)%4;
            }
        }
        //1 set of instruction is executed, return true if It returns to the origin or It does not face North after one execution
        if((x==0 && y==0) || idx!=0 )
        return true;

        return false;
    }
}
