//TC-O(n)
//SC-O(h)
class Solution {
    TreeNode prev;
    TreeNode first;
    TreeNode second;

    public void recoverTree(TreeNode root) {
        dfs(root);
        if (first != null && second != null) {
            int temp = first.val;
            first.val = second.val;
            second.val = temp;
        }

    }

    private void dfs(TreeNode root) {
        if (root == null)
            return;

        dfs(root.left);
        //inorder
        if (prev != null) {
            if (prev.val >= root.val) {
                if (first == null) { //first breach
                    first = prev;
                    second = root;
                } else {
                    second = root; //second breach if there is any
                }

            }
        }
        prev = root;
        dfs(root.right);
    }
}
