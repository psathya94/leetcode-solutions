Iterative solution
//TC-O(n)
//SC-O(h)
class Solution {
    TreeNode prev;
    TreeNode first;
    TreeNode second;

    public void recoverTree(TreeNode root) {
        dfs(root);
        if (first != null && second != null) {
            int temp = first.val;
            first.val = second.val;
            second.val = temp;
        }

    }

    private void dfs(TreeNode root) {

    Stack<TreeNode> stack = new Stack<>();

    while (root != null || !stack.isEmpty()) {

        // Go as far left as possible
        while (root != null) {
            stack.push(root);
            root = root.left;
        }

        // Process node
        root = stack.pop();

        if (prev != null && prev.val >= root.val) {
            if (first == null) {
                first = prev;
                second = root;
            } else {
                second = root;
            }
        }

        prev = root;

        // Move to right subtree
        root = root.right;
    }
}
}
