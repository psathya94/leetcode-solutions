//TC - O(n^T) n -candidates and T is target
//SC - O(h) - height of the recursion tree
class Solution {
    List<List<Integer>> result = new ArrayList<>();
    List<Integer> path = new ArrayList<>();

    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        dfs(0, candidates, path, 0, target);
        return result;
    }

    public void dfs(int index, int[] candidates, List<Integer> path, int currentSum, int target) {
        //base condition and save current value to answer
        if (currentSum == target) {
            result.add(new ArrayList<>(path));
            return;
        }
        if (currentSum > target) {
            return;
        }
        for (int i = index; i < candidates.length; i++) {
            //choose
            path.add(candidates[i]);
            //recurse
            dfs(i, candidates, path, currentSum + candidates[i], target);
            //undo
            path.remove(path.size() - 1);
        }
    }
}
