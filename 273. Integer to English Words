
//Time: O(d) where d is the number of digits -- O(1)
//Auxiliary Space: O(1) (maximum recursion depth is constant)
class Solution {
    private static final String[] BELOW_TWENTY = {
            "", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine",
            "Ten", "Eleven", "Twelve", "Thirteen", "Fourteen", "Fifteen",
            "Sixteen", "Seventeen", "Eighteen", "Nineteen"
    };

    private static final String[] TENS = {
            "", "Ten", "Twenty", "Thirty", "Forty",
            "Fifty", "Sixty", "Seventy", "Eighty", "Ninety"
    };

    private static final String[] THOUSANDS = {
            "", "Thousand", "Million", "Billion"
    };

    public String numberToWords(int num) {

        if (num == 0)
            return "Zero";
        String result = "";
        int i = 0;
        while (num != 0) {
            int triplet = num % 1000;
            if (triplet != 0) {
                result = helper(triplet) + THOUSANDS[i] + " "+ result;
            }
            num = num / 1000;
            i++;
        }
        return result.trim();
    }

    private String helper(int n) {
        if(n==0){
            return "";
        }
        else if (n < 20) {
            return BELOW_TWENTY[n] + " ";
        } else if (n < 100) {
            return TENS[n / 10] + " " + helper(n % 10);
        } else {
            return BELOW_TWENTY[n / 100] + " Hundred " + helper(n % 100);
        }
    }
}
