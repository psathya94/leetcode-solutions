//TC - O(10 L)= O(L)
//SC - O(L)
class Solution {
    public List<String> findRepeatedDnaSequences(String s) {
        Set<String> set = new HashSet<>();
        Set<String> result = new HashSet<>(); //result may contain duplicates so create a set
        for (int i = 0; i <= s.length() - 10; i++) { //<= note
            String substr = s.substring(i, i + 10); //substring - all lowercase
            if (!set.add(substr)) {
                result.add(substr);
            }
        }
        return new ArrayList<>(result);
    }
}
