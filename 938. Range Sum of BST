    private int dfs(TreeNode root, int low, int high) {
        if (root == null) {
            return 0;
        }
        if (root.val >= low && root.val <= high)
            sum += root.val;

        if (root.val > low)
            dfs(root.left, low, high);
        if (root.val < high)
            dfs(root.right, low, high);

        return sum;
    }
}
