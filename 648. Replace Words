//TC- O(NL + S)
//SC - O(NL + S)
class Solution {
    class TrieNode {
        TrieNode[] children;
        boolean isEnd;

        public TrieNode() {
            children = new TrieNode[26];
            isEnd = false;
        }
    }

    TrieNode root = new TrieNode();

    public void insert(String word) { //O(L)
        TrieNode curr = root;
        for (char c : word.toCharArray()) { //apple -> a
            if (curr.children[c - 'a'] == null) {
                curr.children[c - 'a'] = new TrieNode();
            }
            curr = curr.children[c - 'a'];
        }
        curr.isEnd = true;
    }

    public String replaceWords(List<String> dictionary, String sentence) {
        //step 1: Build trie
        for (String word : dictionary) {//O(N)
            insert(word);
        }
        String[] strList = sentence.trim().split("\\s+");//O(S)
        StringBuilder result = new StringBuilder();
        for (String s : strList) { //O(S) for searching the entire string
            String re = search(s);
            result.append(re);
            result.append(" ");
        }
        return result.toString().trim();
    }

    public String search(String word) {
        TrieNode curr = root;
        for (int i = 0; i < word.length(); i++) {
            char c = word.charAt(i);
            TrieNode child = curr.children[c - 'a'];
            if (child == null) {
                return word;
            } else if (child.isEnd) {
                return word.substring(0,i+1); //O(S)
            }
            curr = child;
        }
        return word;
    }
}
