/**
Time Complexity
    Best Case - O(min(s,p))
    Average case -O(s log p) Carl Barton Theorem
    Worst case - O(s*p)

Space Complexity
O(1)
 */
class Solution {
    public boolean isMatch(String s, String p) {
        int sl = s.length();
        int pl = p.length();
        int sp = 0;
        int pp = 0;
        int sStar = -1;
        int pStar = -1;
        while (sp < sl) { //pp<pl should not be added to while because, dry run s=abc p=* and s=abc p=?
            if (pp < pl && (s.charAt(sp) == p.charAt(pp) || p.charAt(pp) == '?')) {
                sp++;
                pp++;
            } else if (pp < pl && p.charAt(pp) == '*') {
                sStar = sp;
                pStar = pp;
                pp++; //0 case, * matches with empty
            } else if (pStar == -1) {
                return false;
            } else {
                sStar++;
                sp = sStar;
                pp = pStar+1;
            }
        }
        while (pp < pl) { //eg: s=abc p=abc****
            if (p.charAt(pp) != '*')
                return false;
            pp++;
        }
        return true;
    }
}
