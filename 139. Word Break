//TC- O(n^3)
//SC - O(n + D) n for dp array and D for hashset
class Solution {
    public boolean wordBreak(String s, List<String> wordDict) {
        Set<String> set = new HashSet<>(wordDict);

        int n = s.length();
        boolean[] dp = new boolean[n + 1];
        dp[0] = true;

        for (int i = 1; i < n+1; i++) { //O(n)
            for (int j = 0; j < i; j++) { //O(n)
                if (dp[j]) {
                    String str = s.substring(j,i); //O(n)
                    if (set.contains(str)) {
                        dp[i] = true;
                         //j=i; or break;
                         break;
                    }
                }
            }
        }
        return dp[n];
    }
}
