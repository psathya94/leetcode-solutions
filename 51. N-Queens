//TC - n!
//SC-O(m*n)
class Solution {
    boolean[][] board;
    List<List<String>> result;

    public List<List<String>> solveNQueens(int n) {
        board = new boolean[n][n];
        result = new ArrayList<>();
        dfs(0,n);
        return result;
    }

    private void dfs(int r, int n) {
        //base
        if (r == n) {
            ArrayList<String> list = new ArrayList<>();
            for (int i = 0; i < n; i++) {
                StringBuilder sb = new StringBuilder();
                for (int j = 0; j < n; j++) {
                    if(board[i][j])
                        sb.append("Q");
                    else
                        sb.append(".");
                }
                list.add(sb.toString());
            }
            result.add(new ArrayList<>(list));
            return;
        }
        //logic
        for (int i = 0; i < n; i++) {
            if (isSafe(r, i,n)) {
                board[r][i] = true;
                dfs(r + 1, n);
            board[r][i] = false;
            }
            
        }
    }

    private boolean isSafe(int row, int column, int n){
        //up
        int r=row; int c = column;
        while(r>=0){
            if(board[r][c])
                return false;
            r--;
        }

        //left diagonal
        r=row;  c = column;
        while(r>=0 && c>=0){
            if(board[r][c])
                return false;
            r--; c--;
        }

        //right diagonal
        r=row;  c = column;
        while(r>=0 && c<n){
            if(board[r][c])
                return false;
            r--; c++;
        }
        return true;
    }
}
