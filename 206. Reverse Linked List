/**
 * Definition for singly-linked list.
 * public class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode() {}
 *     ListNode(int val) { this.val = val; }
 *     ListNode(int val, ListNode next) { this.val = val; this.next = next; }
 * }
 */
 //TC - O(n)
 //SC - O(1)
class Solution {
    public ListNode reverseList(ListNode head) {
        if (head == null)
            return null;
        ListNode p1 = null;
        ListNode p2 = head;
        
        while (p2 != null) {
            ListNode p3 = p2.next; //initializing p3 here is a good idea as it is local variable.
            p2.next = p1;
            p1 = p2;
            p2 = p3;
            //if (p3 != null)
            //    p3 = p3.next;
        }
        return p1;
    }
}
