Below version uses a seperate visited array
class Solution {
    public int snakesAndLadders(int[][] board) {

        int row = board.length;
        int col = board[0].length;

        // Flatten board
        int[] arr = new int[row * col];

        boolean leftToRight = true;
        int r = row - 1;
        int c = 0;

        for (int i = 0; i < arr.length; i++) {

            if (board[r][c] == -1)
                arr[i] = -1;
            else
                arr[i] = board[r][c] - 1;

            if (leftToRight) {
                c++;

                if (c == col) {
                    c--;
                    r--;
                    leftToRight = false;
                }

            } else {
                c--;

                if (c < 0) {
                    c++;
                    r--;
                    leftToRight = true;
                }
            }
        }

        // BFS
        Queue<Integer> queue = new LinkedList<>();
        boolean[] visited = new boolean[arr.length];

        queue.offer(0);
        visited[0] = true;

        int moves = 0;

        while (!queue.isEmpty()) {

            int size = queue.size();
            moves++;

            while (size > 0) {

                int idx = queue.poll();

                for (int dice = 1; dice <= 6; dice++) {

                    int newIdx = idx + dice;

                    if (newIdx >= arr.length)
                        break;

                    // Snake or ladder
                    if (arr[newIdx] != -1)
                        newIdx = arr[newIdx];

                    // Reached final square
                    if (newIdx == arr.length - 1)
                        return moves;

                    if (!visited[newIdx]) {
                        visited[newIdx] = true;
                        queue.offer(newIdx);
                    }
                }

                size--;
            }
        }

        return -1;
    }
}
