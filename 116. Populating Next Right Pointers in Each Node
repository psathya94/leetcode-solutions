Optimized solution
//TC:O(n)
//SC:O(1)
class Solution {
    public Node connect(Node root) {
        
        Node level = root;
        while (level != null && level.left != null) {
            Node curr = level;
            while (curr != null) { 
                curr.left.next = curr.right;
                if (curr.next != null)
                    curr.right.next = curr.next.left;

                curr = curr.next;
            }
            level = level.left;
        }
        return root;
    }

}
