//TC:O(n)
//SC:O(n)
class Solution {
    public Node connect(Node root) {
        if (root != null)
            bfs(root);
        return root;
    }

    private void bfs(Node root) {
        //if(root==null)
        //return root;
        Queue<Node> queue = new LinkedList<>();
        queue.offer(root);
        while (!queue.isEmpty()) {
            int size = queue.size();
            for (int i = 0; i < size; i++) {
                Node one = queue.poll();
                if (i < size - 1) {
                    //process
                    one.next = queue.peek();
                }

                //add children to queue
                if (one.left != null)
                    queue.offer(one.left);
                if (one.right != null)
                    queue.offer(one.right);
            }
        }
    }
}

