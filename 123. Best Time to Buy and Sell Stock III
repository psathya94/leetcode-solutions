//TC - O(n)
//SC - O(1)
class Solution {
    public int maxProfit(int[] prices) {
        if (prices.length < 2 || prices == null)
            return 0;

        int n = prices.length;
        int buy1 = Integer.MAX_VALUE;
        int sell1 = Integer.MIN_VALUE;
        int buy2 = Integer.MAX_VALUE;
        int sell2 = Integer.MIN_VALUE;

        for (int i = 0; i < n; i++) {
            buy1 = Math.min(buy1, prices[i]); //min buy
            sell1 = Math.max(sell1, prices[i] - buy1);
            buy2 = Math.min(buy2, prices[i] - sell1); //effective price includes profit from transaction 1
            sell2 = Math.max(sell2, prices[i] - buy2);
        }
        return sell2;
    }
}
