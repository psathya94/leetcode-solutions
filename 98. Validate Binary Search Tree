/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    TreeNode prev;
    public boolean isValidBST(TreeNode root) {
        return dfs(root);
    }
    private boolean dfs(TreeNode root) {
        if(root==null){
            return true;
        }
        if(!dfs(root.left)) //if left subtree returns false, send it to the parent
            return false;
        if(prev!=null){
            if(prev.val>=root.val){
                System.out.println("prev.val"+ prev.val+"root.val"+root.val);
                return false;
            }
        }
        prev = root;
        // 3. Visit right subtree
        if (!dfs(root.right)) {
            return false;
        }
        return true;
    }
}
