//TC - O(n log n)+n
//SC - O(n)
class Solution {
    public int[][] merge(int[][] intervals) {
        List<int[]> list = new ArrayList<>();
        //Step 1: sort the array
        //ex: [[2,3],[4,5],[6,7],[8,9],[1,10]] 
        //o/p should be [1,10], if not sorted output will be [[2,3],[4,5],[6,7],[1,10]]
        Arrays.sort(intervals, (a,b)->
        {
            return Integer.compare(a[0],b[0]);
            });
        int prevStart = intervals[0][0];
        int prevEnd = intervals[0][1];
        for (int i = 1; i < intervals.length; i++) {
            int currStart = intervals[i][0];
            int currEnd = intervals[i][1];
            //3 cases
            if (prevEnd < currStart) {
                list.add(new int[] { prevStart, prevEnd });
                prevStart = currStart;
                prevEnd = currEnd;
            } 
            /**
            //not needed, as we're sorting the array the below condition never occurs
            else if (currEnd < prevStart) { //[[1,4],[0,0]]
                list.add(new int[] { currStart, currEnd });
            }  */
            else {
                prevStart = Math.min(prevStart, currStart);
                prevEnd = Math.max(prevEnd, currEnd);
            }
        }
        list.add(new int[] { prevStart, prevEnd });
        return list.toArray(new int[list.size()][]);
    }
}
