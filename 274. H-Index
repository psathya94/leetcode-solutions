//TC - O(n log n)
//SC: O(1) extra (ignoring sorting recursion)
class Solution {
    public int hIndex(int[] citations) {
        Arrays.sort(citations); //O(n log n)
        int n = citations.length;
        int h = 0;
        for (int i = 0; i < n; i++) { //O(n)
            h = Math.max(h, Math.min(citations[i], n-i));
        }
        return h;
    }
}


