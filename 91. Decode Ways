//TC - O(n)
//SC - O(n)
class Solution {
    public int numDecodings(String s) {
        if (s.charAt(0) == '0') {
            return 0; //any string starts with 0 is invalid, cannot be decoded
        }
        int n = s.length();
        int[] dp = new int[n + 1];
        dp[0] = 1; //there is only one way to decode empty string
        dp[1] = 1;
        for (int i = 2; i < dp.length; i++) {
            int singleDigit = s.charAt(i-1) -'0';
            if(singleDigit!=0){
                dp[i] = dp[i] + dp[i-1];
            }

            //double digit
            int twoDigit = (s.charAt(i-2) -'0')*10 + (s.charAt(i-1) -'0');
            if(twoDigit>=10 && twoDigit<=26){
                dp[i] = dp[i] + dp[i-2];
            }
        }
        return dp[dp.length-1];
    }
}
/**
dp[i] represents the number of ways to decode the first i characters. At each position, I check whether the last digit can be decoded by itself. If it can, all the ways to decode the previous i-1 characters can be extended, so I add dp[i-1]. I also check whether the last two digits form a number between 10 and 26. If they do, I add dp[i-2]. dp[0] = 1 represents one way to successfully decode an empty prefix.
 */
