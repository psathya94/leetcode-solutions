//TC - O(r*c)
//SC - O(c)
class Solution {
    public int minDistance(String word1, String word2) {
        int r = word1.length();
        int c = word2.length();
        if (r == 0 && c == 0)
            return 0;
        int[] dp = new int[c + 1];

        //fill first row
        for (int j = 1; j < dp.length; j++) {
            dp[j] = j;
        }

        //fill remaining row and col
        for (int i = 1; i <= r; i++) {
            int diag = dp[0]; //update diag during every row
            dp[0] = i; // fill first row
            for (int j = 1; j <= c; j++) {
                int temp = dp[j];
                if (word1.charAt(i - 1) == word2.charAt(j - 1)) {
                    dp[j] = diag;
                } else {
                    int add = dp[j];
                    int replace = diag;
                    int delete = dp[j - 1];
                    dp[j] = 1 + Math.min(delete, Math.min(add, replace));
                }
                diag = temp;
            }
        }
        return dp[c];
    }
}
