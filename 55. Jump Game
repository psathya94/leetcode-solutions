class Solution {
    public boolean canJump(int[] nums) {
        int n = nums.length;
        if (n < 2)
            return true;
        int target = n - 1; //last index
        for (int i = n - 2; i >= 0; i--) {
            if (i + nums[i] >= target)
                target = i;
        }
        return target == 0;
    }
}
