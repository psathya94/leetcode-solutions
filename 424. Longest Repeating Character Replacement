//TC - O(n)
//SC - O(1)
class Solution {
    public int characterReplacement(String s, int k) {
        int left = 0;
        int maxFre = 0;
        int[] count = new int[26];
        int re = 0;
        for (int right = 0; right < s.length(); right++) {
            maxFre = Math.max(maxFre, ++count[s.charAt(right) - 'A']);
            while (right - left + 1 - maxFre > k) { //do not use window variable, as we update left and right, window also need another calculation
                count[s.charAt(left) - 'A']--;
                left++;
            }
            re = Math.max(re, right - left + 1);
        }
        return re;
    }
}
