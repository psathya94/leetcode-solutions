//TC-O(n^2)
//SC-O(1)
class Solution {
    int gStart = 0;
    int gEnd = 0;

    public String longestPalindrome(String s) {
        if (s == null || s.length() == 0)
            return "";
        for (int i = 0; i < s.length(); i++) {
            extendAroundtheCenter(s, i, i);
            //if (i != s.length() - 1 && s.charAt(i) == s.charAt(i + 1)) { //not needed as boundary check is done in extendAroundCenter method
                extendAroundtheCenter(s, i, i + 1);
            //}
        }
        return s.substring(gStart, gEnd+1);
    }

    private void extendAroundtheCenter(String s, int left, int right) {
        while (left >= 0 && right < s.length() && s.charAt(left) == s.charAt(right)) {
            left--;
            right++;
        }
        left++;
        right--;

        if (right - left > gEnd - gStart) {
            gStart = left;
            gEnd = right;
        }
    }
}
