/**
 * Definition for singly-linked list.
 * class ListNode {
 *     int val;
 *     ListNode next;
 *     ListNode(int x) {
 *         val = x;
 *         next = null;
 *     }
 * }
 */
//TC - O(n)
//SC - O(1)
public class Solution {
    public boolean hasCycle(ListNode head) {
        if (head == null)
            return false;
        ListNode slow = head;
        ListNode fast = head;
        while (fast != null && fast.next != null) {
            slow = slow.next;
            fast = fast.next.next;
            if (slow == fast)
                return true;
        }
        return false;
    }
}
/**
Algorithm
I'll use Floyd's cycle detection algorithm. I'll maintain two pointers, slow and fast. Slow moves one node at a time, while fast moves two nodes. 
If there is no cycle, fast will reach null. If there is a cycle, both pointers will eventually be inside the cycle, and fast will catch slow. Therefore, if slow == fast, a cycle exists
