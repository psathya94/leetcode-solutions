//TC - O(log n)
//SC - O(log n) - recursive stack space
class Solution {
    int answer ;
    public double myPow(double x, int n) {
            long N = n;
        if(n<0){
            x = 1/x;
            N = -N;
        }
        return helper(x,N);
            
    }
    private double helper(double x, long n){
        //base
        if(n==0)
            return 1;
        //logic
        double val = helper(x,n/2);
        if(n%2==0){
            return val*val;
        }
        else{
            return val*val *x;
        }
    }
}
