//TC - O(O+N*L) whre n is no of words and l is the length of every word
//SC - O(1)
class Solution {
    public boolean isAlienSorted(String[] words, String order) {
        HashMap<Character, Integer> map = new HashMap<>();
        for (int i = 0; i < order.length(); i++) {
            char c = order.charAt(i);
            map.put(c, i);
        }

        for (int i = 1; i < words.length; i++) {
            String s1 = words[i - 1];
            String s2 = words[i];
            int len1 = s1.length();
            int len2 = s2.length();
            int len = Math.min(len1, len2);
            for (int j = 0; j < len; j++) {
                if (s1.charAt(j) != s2.charAt(j)) {
                    if (map.get(s1.charAt(j)) > map.get(s2.charAt(j)))
                        return false;
                    else
                        break;
                }
            }
            //apple,app
            if (len1 > len2) {
                if (s1.startsWith(s2))
                    return false;
            }
        }
        return true;
    }
}
