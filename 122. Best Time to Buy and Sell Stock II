//TC - O(n)
//SC - O(1)
class Solution {
    public int maxProfit(int[] prices) {
        if (prices == null || prices.length < 2)
            return 0;
        int buy = prices[0];
        int currentProfit = 0;
        int maxProfit = 0;

        for (int i = 1; i < prices.length; i++) {
            if(prices[i]>buy){
                //calculate cp, mp
                currentProfit = prices[i]-buy;
                maxProfit += currentProfit;
            }
                //update buy
                buy = prices[i];
            }
        return maxProfit;
    }
}
