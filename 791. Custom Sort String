//TC - O(n+m)
//SC - O(1)
class Solution {
    public String customSortString(String order, String s) {
        HashMap<Character, Integer> map = new HashMap<>();
        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);
            int count = map.getOrDefault(ch, 0);
            map.put(ch, count + 1);
        }
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < order.length(); i++) {
            char ch = order.charAt(i);
            int count =0;
            if (map.containsKey(ch)) {
                count = map.get(ch);
                map.remove(ch);
            }
            while (count > 0) {
                sb.append(ch);
                count--;
            }

        }
        for (Character c : map.keySet()) {
            int count = map.get(c);
            while (count > 0) {
                sb.append(c);
                count--;
            }
        }
        return sb.toString();
    }
}
/**
Approach

I first count the frequency of every character in s. Then I traverse the custom order string and append each character according to its frequency, removing it from the map after processing. Finally, I append the remaining characters that were not specified in order
 */
