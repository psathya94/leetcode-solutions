class Solution {
    public int maxSubArray(int[] nums) {
        int n = nums.length;
        int start = -1;
        int end = -1;
        int gstart = -1;
        int gend = -1;
        int currSum = nums[0]; //note
        int max = nums[0]; //note
        for (int i = 1; i < n; i++) {
            if (currSum + nums[i] < nums[i]) {
                currSum = nums[i];
                start = i;
                //end = i; --not needed as i indicates the end of the currSum subarray
            } else {
                currSum = currSum + nums[i];
                //end++;
            }
            if (currSum > max) {
                max = currSum;
                gstart = start;
                //gend = end;
                gend = i;
            }
        }
        System.out.println(gstart + " " + gend);
        return max;
    }
}
